<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/widget_setting_background_colors"
    android:background="@color/widget_setting_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/RobotoMediumStyle"
        android:textSize="13sp"
        android:textColor="#8c8c8c"
        android:gravity="center_vertical"
        android:id="@+id/widget_setting_seekbar_title"
        android:background="@color/widget_setting_background"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="@string/base_widget_setting_background_color"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>
    <RelativeLayout
        android:id="@+id/radio_button_container"
        android:background="@color/widget_setting_item_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/widget_setting_background_color_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/radio_match_with_setting_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/widget_setting_radio_button_padding"
                    android:paddingEnd="@dimen/widget_setting_radio_button_padding"
                    android:stateListAnimator="?attr/seslSmallTouchAnimator">
                    <RadioButton
                        android:textAppearance="@style/RobotoRegularStyle"
                        android:textSize="@dimen/widget_setting_radio_button_text_size"
                        android:textColor="@color/widget_setting_title_color"
                        android:ellipsize="end"
                        android:id="@+id/radio_match_with_setting"
                        android:background="@null"
                        android:focusable="false"
                        android:clickable="false"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/widget_setting_radio_button_height"
                        android:button="@drawable/btn_radio_anim"
                        android:maxLines="1"
                        android:paddingStart="@dimen/widget_setting_radio_button_padding"
                        android:paddingEnd="@dimen/widget_setting_radio_button_padding"/>
                </FrameLayout>
            </FrameLayout>
            <View
                android:background="@color/widget_setting_divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="2dp"/>
            <FrameLayout
                android:id="@+id/radio_white_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/widget_setting_radio_button_padding"
                    android:paddingEnd="@dimen/widget_setting_radio_button_padding"
                    android:stateListAnimator="?attr/seslSmallTouchAnimator">
                    <RadioButton
                        android:textAppearance="@style/RobotoRegularStyle"
                        android:textSize="@dimen/widget_setting_radio_button_text_size"
                        android:textColor="@color/widget_setting_title_color"
                        android:id="@+id/radio_white"
                        android:background="@null"
                        android:focusable="false"
                        android:clickable="false"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/widget_setting_radio_button_height"
                        android:button="@drawable/btn_radio_anim"
                        android:text="@string/base_widget_setting_white"
                        android:paddingStart="@dimen/widget_setting_radio_button_padding"
                        android:paddingEnd="@dimen/widget_setting_radio_button_padding"/>
                </FrameLayout>
            </FrameLayout>
            <View
                android:background="@color/widget_setting_divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="2dp"/>
            <FrameLayout
                android:id="@+id/radio_black_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/widget_setting_radio_button_padding"
                    android:paddingEnd="@dimen/widget_setting_radio_button_padding"
                    android:stateListAnimator="?attr/seslSmallTouchAnimator">
                    <RadioButton
                        android:textAppearance="@style/RobotoRegularStyle"
                        android:textSize="@dimen/widget_setting_radio_button_text_size"
                        android:textColor="@color/widget_setting_title_color"
                        android:id="@+id/radio_black"
                        android:background="@null"
                        android:focusable="false"
                        android:clickable="false"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/widget_setting_radio_button_height"
                        android:button="@drawable/btn_radio_anim"
                        android:text="@string/base_widget_setting_black"
                        android:paddingStart="@dimen/widget_setting_radio_button_padding"
                        android:paddingEnd="@dimen/widget_setting_radio_button_padding"/>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
        <com.samsung.android.support.senl.nt.base.winset.view.RoundCornerOverlayView
            android:id="@+id/widget_setting_background_color_round_overlay"
            android:layout_width="match_parent"
            android:layout_height="159dp"
            custom:corner="all"
            custom:overlayColor="@color/widget_setting_background"/>
    </RelativeLayout>
</LinearLayout>
