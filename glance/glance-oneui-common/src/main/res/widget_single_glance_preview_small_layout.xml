<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/widget_list_glance_preview_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/widget_preview_shortcut_1"
                style="@style/WidgetPreviewSingleGlanceSmallSubtitle"/>
            <TextView
                android:text=" "
                style="@style/WidgetPreviewSingleGlanceMediumSubtitle"/>
            <TextView
                android:text="@string/widget_preview_shortcut_buy_a_gift"
                style="@style/WidgetPreviewSingleGlanceSmallSubtitle"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/widget_preview_shortcut_2"
                style="@style/WidgetPreviewSingleGlanceSmallSubtitle"/>
            <TextView
                android:text=" "
                style="@style/WidgetPreviewSingleGlanceMediumSubtitle"/>
            <TextView
                android:text="@string/widget_preview_shortcut_send_the_invitations"
                style="@style/WidgetPreviewSingleGlanceSmallSubtitle"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
