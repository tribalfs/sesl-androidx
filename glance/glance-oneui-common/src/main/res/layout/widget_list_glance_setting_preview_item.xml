<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/widget_list_item_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_list_glance_setting_item_height"
    android:paddingHorizontal="@dimen/widget_list_item_padding">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumbnail"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        app:shapeAppearanceOverlay="@style/roundedImageViewRounded"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp">
        <TextView
            android:textAppearance="@style/RobotoMediumStyle"
            android:textSize="10.5dp"
            android:textColor="#252525"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="@style/RobotoRegularStyle"
            android:textSize="10.5dp"
            android:textColor="#252525"
            android:ellipsize="end"
            android:id="@+id/content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/RobotoRegularStyle"
                android:textSize="9dp"
                android:textColor="#909090"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <ImageView
                android:id="@+id/favorite"
                android:layout_width="@dimen/widget_list_glance_item_extra_icon_size"
                android:layout_height="@dimen/widget_list_glance_item_extra_icon_size"
                android:src="@drawable/widget_ic_favorite"
                android:layout_marginStart="@dimen/widget_list_item_extra_icon_margin_start"/>
            <ImageView
                android:id="@+id/voice"
                android:layout_width="@dimen/widget_list_glance_item_extra_icon_size"
                android:layout_height="@dimen/widget_list_glance_item_extra_icon_size"
                android:src="@drawable/widget_ic_voice"
                android:tint="@color/widget_voice_icon_color"/>
        </LinearLayout>
        <View
            android:id="@+id/divider"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.03dp"
            android:layout_marginTop="4.62dp"/>
    </LinearLayout>
</LinearLayout>
