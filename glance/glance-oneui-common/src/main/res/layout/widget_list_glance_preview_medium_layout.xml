<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/widget_list_glance_preview_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp">
        <RelativeLayout
            android:id="@+id/widget_title_layout"
            android:layout_width="match_parent"
            android:layout_height="23dp"
            android:layout_marginTop="@dimen/widget_list_glance_preview_item_margin_top"
            android:layout_toStartOf="@+id/widget_add">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/widget_list_glance_preview_item_title_text_color"
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_app_name_simple"
                android:layout_centerVertical="true"
                android:fontFamily="sec"
                android:textFontWeight="600"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_alignParentEnd="true">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_alignParentEnd="true">
                    <RelativeLayout
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_marginEnd="5dp">
                        <ImageView
                            android:gravity="center_vertical"
                            android:id="@+id/widget_add_new"
                            android:background="@drawable/ellipse_2"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="true"
                            android:contentDescription="Add Notes"/>
                        <ImageView
                            android:background="@drawable/widget_list_preview_add_new_note_icon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:includeFontPadding="true"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:gravity="center_vertical"
                            android:background="@drawable/ellipse_2"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="true"
                            android:contentDescription="Add Notes"/>
                        <ImageView
                            android:background="@drawable/ic_widget_add_note"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:includeFontPadding="true"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:id="@+id/divider"
            android:background="@color/widget_list_glance_preview_divider_color_light"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/widget_list_glance_preview_divider_margin_top"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="14dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/widget_list_glance_preview_item_margin_divider">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:src="@drawable/thumbnail_1"
                    android:layout_marginEnd="8dp"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/widget_list_glance_preview_item_title_text_color"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_preview_note_list_glance_title1_handwritting"
                            android:maxLines="1"
                            android:fontFamily="sec"
                            android:textFontWeight="600"/>
                        <TextView
                            android:textSize="10dp"
                            android:textColor="@color/widget_list_glance_preview_item_title_text_color"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0.8dp"
                            android:text="@string/widget_preview_note_list_glance_sub_date1"
                            android:maxLines="1"
                            android:fontFamily="sec"
                            android:textFontWeight="400"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_list_glance_preview_item2_margin_item1"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:src="@drawable/thumbnail_2"
                    android:layout_marginEnd="8dp"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/widget_list_glance_preview_item_title_text_color"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_preview_note_list_title1_meeting"
                            android:maxLines="1"
                            android:fontFamily="sec"
                            android:textFontWeight="600"/>
                        <TextView
                            android:textSize="10dp"
                            android:textColor="@color/widget_list_glance_preview_item_title_text_color"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_preview_note_list_glance_sub_date2"
                            android:maxLines="1"
                            android:fontFamily="sec"
                            android:textFontWeight="400"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
