<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/widget_setting_item_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="18dp">
    <ImageButton
        android:id="@+id/delete"
        android:background="@drawable/comp_ripple_circle_effect"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/widget_list_delete"
        android:scaleType="fitXY"
        android:contentDescription="@string/action_delete"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/thumbnail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumbnail"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/title_container"
        app:layout_constraintStart_toEndOf="@+id/delete"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/roundedImageViewRounded"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/reorder"
        app:layout_constraintStart_toEndOf="@+id/thumbnail"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="@style/RobotoMediumStyle"
            android:textSize="14sp"
            android:textColor="@color/widget_glance_reorder_item_text_color"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <TextView
                android:textAppearance="@style/RobotoRegularStyle"
                android:textSize="12sp"
                android:textColor="@color/widget_glance_reorder_item_text_color"
                android:ellipsize="end"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <ImageView
                android:id="@+id/favorite"
                android:layout_width="@dimen/widget_list_glance_item_extra_icon_size"
                android:layout_height="@dimen/widget_list_glance_item_extra_icon_size"
                android:src="@drawable/widget_ic_favorite"
                android:layout_marginStart="@dimen/widget_list_item_extra_icon_margin_start"/>
            <ImageView
                android:id="@+id/voice"
                android:layout_width="@dimen/widget_list_glance_item_extra_icon_size"
                android:layout_height="@dimen/widget_list_glance_item_extra_icon_size"
                android:src="@drawable/widget_ic_voice"
                android:tint="@color/widget_voice_icon_color"/>
        </LinearLayout>
    </LinearLayout>
    <ImageButton
        android:id="@+id/reorder"
        android:background="@drawable/comp_ripple_circle_effect"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_reorder_handle_settings_chevron_up_chevron_down"
        android:scaleType="fitXY"
        android:contentDescription="@string/reorder_note"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/title_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/widget_setting_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
