<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_list_glance_setting_change_container"
    android:background="@color/widget_setting_item_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/widget_list_setting_select_notes"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp">
            <TextView
                android:textAppearance="@style/RobotoRegularStyle"
                android:textSize="17sp"
                android:textColor="@color/widget_setting_title_color"
                android:ellipsize="end"
                android:id="@+id/widget_list_setting_select_note_title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/widget_list_setting_select_note"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:stateListAnimator="?attr/seslSmallTouchAnimator"/>
            <TextView
                android:textAppearance="@style/RobotoRegularStyle"
                android:textSize="13sp"
                android:textColor="@color/notes_primary_color"
                android:ellipsize="end"
                android:id="@+id/widget_list_setting_selected_sub_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:stateListAnimator="?attr/seslSmallTouchAnimator"/>
        </LinearLayout>
        <View
            android:background="@color/widget_setting_divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="18dp"/>
        <RelativeLayout
            android:id="@+id/widget_list_setting_reorder_notes"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp">
            <TextView
                android:textAppearance="@style/RobotoRegularStyle"
                android:textSize="17sp"
                android:textColor="@color/widget_setting_title_color"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_list_setting_reorder_notes"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:stateListAnimator="?attr/seslSmallTouchAnimator"
                android:layout_marginVertical="12dp"/>
        </RelativeLayout>
    </LinearLayout>
    <com.samsung.android.support.senl.nt.base.winset.view.RoundCornerOverlayView
        android:id="@+id/widget_list_glance_setting_control_change_round_corner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        custom:corner="all"
        custom:overlayColor="@color/widget_setting_background"/>
</FrameLayout>
