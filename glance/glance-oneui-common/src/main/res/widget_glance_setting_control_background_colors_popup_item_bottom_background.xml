        <shape android:shape="rectangle">
            <solid android:color="@color/widget_common_list_ripple_color"/>
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="26dp"
                android:bottomRightRadius="26dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_setting_item_color"/>
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="26dp"
                android:bottomRightRadius="26dp"/>
        </shape>
    </item>
</selector>
