<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp">
    <FrameLayout
        android:id="@+id/shape_item_container"
        android:layout_width="58dp"
        android:layout_height="68dp"
        android:stateListAnimator="?attr/seslLargeTouchAnimator">
        <ImageView
            android:id="@+id/bg_shape"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/check_icon"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/widget_glance_setting_shape_bg_select_check"
            android:tint="@color/widget_glance_setting_control_shape_background_select_check_color"/>
    </FrameLayout>
</FrameLayout>
