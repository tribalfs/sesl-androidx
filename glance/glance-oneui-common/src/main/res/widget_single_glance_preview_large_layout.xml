<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/widget_list_glance_preview_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:ellipsize="end"
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="23dp"
        android:layout_marginTop="@dimen/widget_preview_single_note_title_padding_top"
        android:layout_marginBottom="7dp"
        android:text="@string/widget_preview_shortcut_bake_a_cake"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="42dp"
        style="@style/WidgetPreviewNoteListTitleGlance"/>
    <TextView
        android:id="@+id/divider"
        android:background="@color/widget_list_glance_preview_divider_color_light"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="0dp"
        android:layout_below="@+id/widget_title"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_preview_single_note_sub_padding_title"
        android:layout_marginBottom="@dimen/widget_preview_single_note_item_padding_bottom"
        android:layout_marginHorizontal="14dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/widget_preview_shortcut_1"
                style="@style/WidgetPreviewSingleGlanceMediumSubtitle"/>
            <TextView
                android:text=" "
                style="@style/WidgetPreviewSingleGlanceMediumSubtitle"/>
            <TextView
                android:ellipsize="end"
                android:text="@string/widget_preview_shortcut_combine_the_eggs_milk"
                android:maxLines="2"
                style="@style/WidgetPreviewSingleGlanceMediumSubtitle"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_preview_single_note_item2_padding_item1">
            <TextView
                android:text="@string/widget_preview_shortcut_2"
                style="@style/WidgetPreviewSingleGlanceMediumSubtitle"/>
            <TextView
                android:text=" "
                style="@style/WidgetPreviewSingleGlanceMediumSubtitle"/>
            <TextView
                android:ellipsize="end"
                android:text="@string/widget_preview_shortcut_in_a_separate_bowl_whisk"
                android:maxLines="2"
                style="@style/WidgetPreviewSingleGlanceMediumSubtitle"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
