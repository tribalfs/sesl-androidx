<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:id="@+id/checked"
        android:drawable="@drawable/picker_app_grid_item_checkbox_checked"/>
    <item
        android:state_checked="false"
        android:id="@+id/unchecked"
        android:drawable="@drawable/picker_app_grid_item_checkbox_unchecked"/>
    <transition
        android:drawable="@drawable/picker_app_checkbox_anim_uncheck_to_check"
        android:toId="@+id/checked"
        android:fromId="@+id/unchecked"/>
    <transition
        android:drawable="@drawable/picker_app_checkbox_anim_check_to_uncheck"
        android:toId="@+id/unchecked"
        android:fromId="@+id/checked"/>
</animated-selector>
