<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt" android:ordering="together">
    <set android:ordering="sequentially">
        <objectAnimator
            android:interpolator="@android:anim/linear_interpolator"
            android:duration="100"
            android:valueFrom="#ffffff"
            android:valueTo="#99999d"
            android:propertyName="strokeColor"/>
        <objectAnimator
            android:interpolator="@android:anim/linear_interpolator"
            android:duration="1"
            android:startOffset="15"
            android:valueFrom="#99999d"
            android:valueTo="?attr/colorPrimary"
            android:propertyName="strokeColor"/>
        <objectAnimator
            android:duration="183"
            android:valueFrom="?attr/colorPrimary"
            android:valueTo="?attr/colorPrimary"
            android:propertyName="strokeColor"/>
    </set>
    <set android:ordering="sequentially">
        <objectAnimator
            android:interpolator="@android:anim/linear_interpolator"
            android:duration="100"
            android:valueFrom="2"
            android:valueTo="6"
            android:propertyName="strokeWidth"/>
        <objectAnimator
            android:interpolator="@android:anim/linear_interpolator"
            android:duration="1"
            android:startOffset="15"
            android:valueFrom="6"
            android:valueTo="8"
            android:propertyName="strokeWidth"/>
    </set>
</set>
