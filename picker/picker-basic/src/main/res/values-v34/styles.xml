<?xml version="1.0" encoding="utf-8" standalone="no"?>
<resources>

    <style name="CalendarHeaderText">
        <item name="android:fontFamily">sec</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="SleepDurationText" parent="">
        <item name="android:fontFamily">sec</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="SleepTimePickerInsideClockNumbers" parent="">
        <item name="android:fontFamily">sec-num-fixed</item>
        <item name="android:textColor">@color/sesl_clock_dial_number_color</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/sesl_sleep_record_clock_dimen</item>
    </style>

    <style name="WakeUpTimePicker_AMPM">
        <item name="android:fontFamily">sec</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:paddingEnd">@dimen/sesl_bedtime_time_picker_ampm_padding</item>
        <item name="android:paddingStart">@dimen/sesl_bedtime_time_picker_ampm_padding</item>
        <item name="android:textColor">@color/sesl_bed_wakeup_time_color</item>
        <item name="android:textFontWeight">300</item>
        <item name="android:textSize">@dimen/sesl_sleep_time_am_pm_size</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="BedTimePicker_AMPM">
        <item name="android:fontFamily">sec</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:paddingEnd">@dimen/sesl_bedtime_time_picker_ampm_padding</item>
        <item name="android:paddingStart">@dimen/sesl_bedtime_time_picker_ampm_padding</item>
        <item name="android:textColor">@color/sesl_bed_wakeup_time_color</item>
        <item name="android:textFontWeight">300</item>
        <item name="android:textSize">@dimen/sesl_sleep_time_am_pm_size</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="BedTimeWakeUpTimeText">
        <item name="android:fontFamily">sec-num-fixed</item>
        <item name="android:textFontWeight">300</item>
    </style>
</resources>